# ============================================================
# TeknoVersus — Dizin listelemeyi kapat (directory listing)
# /karsilastir/, /urun/ gibi klasörlere doğrudan girildiğinde
# sunucunun ham dosya listesini göstermesini engeller. Bu, diğer
# tüm kurallardan tamamen bağımsız, global bir ayardır — hiçbir
# redirect/rewrite kuralıyla çakışmaz.
# ============================================================
Options -Indexes

# ============================================================
# TeknoVersus — Güvenlik başlıkları (Apache / cPanel)
# mod_headers gerektirir (çoğu cPanel hosting'de zaten aktif).
# ============================================================

# ============================================================
# TeknoVersus — Karakter kodlaması (encoding) düzeltmesi
# .txt dosyaları (llms.txt, robots.txt vb.) Content-Type header'ında
# charset belirtmeden gidiyordu; X-Content-Type-Options: nosniff ile
# birleşince bazı tarayıcılar UTF-8 baytlarını yanlış yorumlayıp
# Türkçe karakterleri bozuk gösterebiliyordu.
# ============================================================
<IfModule mod_mime.c>
  AddType 'text/plain; charset=UTF-8' .txt
  AddCharset UTF-8 .txt
</IfModule>

# EK DÜZELTME: Yukarıdaki mod_mime direktifleri, cPanel'in kendi sistem
# seviyesi MIME type tanımı (.txt -> text/plain, charset'siz) tarafından
# geçersiz kılınıyordu (canlı testte doğrulandı — AddType/AddCharset
# etkisizdi). mod_headers ile Content-Type'ı HTTP yanıtının son aşamasında
# doğrudan ve koşulsuz zorluyoruz; bu, MIME type belirleme sürecinden
# tamamen bağımsız çalışır.
<IfModule mod_headers.c>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=UTF-8"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # HSTS — HTTPS'e zorla, 1 yıl (alt domainler dahil)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # MIME sniffing engelle
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking koruması — kendi sitenden iframe'e izin ver, başkasına verme
  Header always set X-Frame-Options "SAMEORIGIN"

  # Referrer bilgisini sınırlı paylaş
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Kullanılmayan tarayıcı izinlerini kapat (kamera/mikrofon/konum kullanılmıyor)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Content-Security-Policy — sitenin GERÇEKTEN kullandığı kaynaklara göre.
  # NOT: AdSense eklendikten sonra genişletildi. script-src hâlâ sıkı (bilinen
  # alan adları), ama img-src/frame-src 'https:' kabul ediyor çünkü reklam
  # görselleri ve iframe'leri rastgele reklamveren alan adlarından geliyor ve
  # önceden listelenemiyor. Görsel/iframe kod çalıştırmadığı için risk düşük.
  # cdnjs (Chart.js), Google Fonts, Google Analytics, Unsplash (kategori
  # banner görselleri), Supabase (admin.html girişi + Amazon linkleri).
  # 'unsafe-inline' script-src'te var çünkü site build sürecinde sayfa
  # başına inline <script> kullanıyor (nonce/hash sistemi yok) — bu, tam
  # bir CSP'nin sağladığı XSS korumasını biraz azaltıyor ama diğer başlıklar
  # (clickjacking, MIME sniffing, HSTS) tam korumada; ilerde script'leri
  # ayrı .js dosyalarına taşırsak 'unsafe-inline' kaldırılıp sıkılaştırılabilir.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://adservice.google.com https://www.google.com https://fundingchoicesmessages.google.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src 'self' https:; connect-src 'self' https://qsetmleywkhjcntajphx.supabase.co https://www.google-analytics.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://ep1.adtrafficquality.google https://csi.gstatic.com https://fundingchoicesmessages.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Admin sayfasını arama motorlarından gizle — netlify.toml'daki ölü
  # ayarın YERİNE gerçek, çalışan bir koruma (bkz. AUTOMATION.md notu).
  <FilesMatch "^admin\.html$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

# Sunucu imzasını gizle (Apache sürüm bilgisi vb.)
ServerSignature Off

# Özel 404 sayfası
ErrorDocument 404 /404.html

# --- Kalıcı yönlendirmeler ---
# Marka karşılaştırma URL'leri artık alfabetik sırayla üretiliyor
# (bkz. lib/generate-brand-vs-brand.js). Google'ın daha önce indekslediği
# ters sıralı adresler 301 ile doğru adrese yönlendiriliyor; böylece
# hem 404 hatası hem de biriken tarama değeri kaybı önleniyor.
Redirect 301 /marka-karsilastir/vestel-vs-tcl-televizyon.html /marka-karsilastir/tcl-vs-vestel-televizyon.html

# ============================================================
# Performans — sıkıştırma ve tarayıcı önbelleği
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# HTTPS'e yönlendir (hosting bunu zaten yapıyorsa bu blok zararsızdır)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================
# FAZ 8 — 301 COMPARISON URL MIGRATION
# Eski (ID'siz) /karsilastir/ URL'lerinden yeni (ID'li) URL'lere
# yönlendirme. Faz 8.5/8.6'da doğrulanmış 301 mapping — her biri
# gerçek eski dosya içeriğinden (isim tahmini değil) çıkarılmış ve
# hedefinin canlıda gerçekten mevcut olduğu doğrulanmıştır.
# 453 eski URL'den 152'si (güncel build'de karşılığı üretilmediği
# için) BİLİNÇLİ OLARAK bu listeye dahil edilmemiştir.
# ============================================
Redirect 301 /karsilastir/acer-aspire-5-vs-casper-nirvana-x500.html /karsilastir/acer-aspire-5-x14-vs-casper-nirvana-x500-y24.html
